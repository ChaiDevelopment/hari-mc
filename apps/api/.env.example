# ───── Runtime ─────
NODE_ENV=development
PORT=4100
# Origin yang boleh memanggil API (koma-separated). Web dev = Next.js di :3000
CORS_ORIGINS=http://localhost:3400
SWAGGER_ENABLED=true
# Set 1 jika API di belakang satu reverse proxy (nginx/Caddy/LB). 0 = akses langsung.
TRUST_PROXY=0

# ───── Database ─────
# Dev: `pnpm db:dev` menjalankan embedded PostgreSQL sesuai URL ini.
DATABASE_URL=postgresql://hmc:CHANGE_ME@127.0.0.1:54329/hari_mc?schema=public

# ───── Auth ─────
# Minimal 32 karakter acak. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS_CUSTOMER=30
REFRESH_TTL_DAYS_ADMIN=7
# Client ID OAuth Google yang diterima sebagai audience ID token (koma-separated).
# Android Credential Manager memakai Web Client ID sebagai serverClientId, jadi biasanya cukup Web Client ID.
GOOGLE_CLIENT_IDS=
# Cookie refresh token untuk web. Set true di production (HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ───── Seed / provisioning ─────
# Email Google Hari Susanto. Dipakai oleh `pnpm admin:provision` jika --email tidak diberikan.
ADMIN_EMAIL=

# ───── Integrasi (opsional — fitur fallback jika kosong) ─────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_PLACES_API_KEY=
INSTAGRAM_ACCESS_TOKEN=

# HANYA dev lokal: login tanpa Google selama OAuth Client ID belum tersedia. Ditolak di production.
ENABLE_DEV_LOGIN=false

# HANYA dev lokal: izinkan dev login ke akun ADMIN yang SUDAH diprovisioning via CLI (tidak pernah membuat admin).
# Butuh ENABLE_DEV_LOGIN=true. Ditolak di production.
ENABLE_DEV_ADMIN_LOGIN=false

# Folder upload (foto profil & portfolio). Production: ganti dengan object storage (Phase 7).
STORAGE_DIR=./storage

# ───── Email (kode masuk tanpa password) ─────
# log  = email TIDAK dikirim; isinya ditulis ke konsol API dan STORAGE_DIR/dev-mailbox (development saja).
# smtp = kirim sungguhan (Brevo, Resend, Mailgun, Amazon SES, Gmail app password, dll.). Wajib di production.
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hari Susanto MC <no-reply@domain-anda.id>"
