{
  // Website pelanggan + CMS (/admin) di Cloudflare Workers via OpenNext.
  // Build:   pnpm --filter @hmc/web cf:build
  // Preview: pnpm --filter @hmc/web cf:preview   (runtime Workers lokal)
  // Deploy:  pnpm --filter @hmc/web cf:deploy    (atau Workers Builds dari GitHub — lihat docs/DEPLOYMENT.md)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hari-mc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    // URL publik API NestJS (Cloudflare Containers / Railway / VPS). WAJIB diganti saat deploy.
    // Bukan rahasia: browser tidak memanggilnya langsung — semua lewat proxy /api/v1 di Worker ini.
    "API_INTERNAL_URL": "https://api.ganti-dengan-domain-api.example"
  }
}
